<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Real-time Object Tracker & Auto Zoom</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #121212;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
    }
    #container {
      position: relative;
      width: 90vw;
      height: 80vh;
      background: #000;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0,0,0,0.6);
      cursor: crosshair;
    }
    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    #controls {
      margin-top: 15px;
      display: flex;
      gap: 12px;
      align-items: center;
    }
    button {
      padding: 8px 16px;
      background-color: #007aff;
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }
    button:hover {
      background-color: #0056b3;
    }
    #info {
      font-size: 0.9rem;
      color: #aaa;
    }
  </style>
  <!-- OpenCV.js 로드 -->
  <script async src="https://docs.opencv.org/4.x/opencv.js" onload="onOpenCvReady()"></script>
</head>
<body>

  <div id="container">
    <canvas id="outputCanvas"></canvas>
  </div>

  <div id="controls">
    <button id="resetBtn">추적 해제</button>
    <span id="info">OpenCV.js 로딩 중... 화면을 드래그하여 대상을 선택하세요.</span>
  </div>

  <video id="webcam" autoplay playsinline style="display:none;"></video>

  <script>
    const video = document.getElementById('webcam');
    const canvas = document.getElementById('outputCanvas');
    const ctx = canvas.getContext('2d');
    const infoText = document.getElementById('info');
    const resetBtn = document.getElementById('resetBtn');
    const container = document.getElementById('container');

    let cvReady = false;
    let tracker = null;
    let isTracking = false;
    let bbox = null; // [x, y, w, h]

    // 드래그 관련 변수
    let isDragging = false;
    let startX = 0, startY = 0;
    let currentX = 0, currentY = 0;

    // 카메라 줌/이동 연출용 보정치 (Smooth follow)
    let currentZoom = 1;
    let currentCenterX = 0;
    let currentCenterY = 0;

    function onOpenCvReady() {
      cvReady = true;
      infoText.innerText = '카메라를 연결하는 중...';
      startCamera();
    }

    // 1. 최대 해상도 카메라 설정
    async function startCamera() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: {
            width: { ideal: 3840, max: 3840 },
            height: { ideal: 2160, max: 2160 },
            facingMode: 'environment'
          },
          audio: false
        });
        video.srcObject = stream;
        video.onloadedmetadata = () => {
          video.play();
          canvas.width = video.videoWidth;
          canvas.height = video.videoHeight;
          currentCenterX = canvas.width / 2;
          currentCenterY = canvas.height / 2;
          infoText.innerText = `해상도: ${video.videoWidth}x${video.videoHeight} | 드래그하여 대상을 선택하세요.`;
          requestAnimationFrame(processVideo);
        };
      } catch (err) {
        console.error("카메라 접근 실패:", err);
        infoText.innerText = '카메라를 불러올 수 없습니다. 권한을 확인해 주세요.';
      }
    }

    // 2. 좌표 변환 (화면 Canvas 좌표 -> 원본 Video 해상도 좌표)
    function getCanvasCoords(e) {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;

      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;

      return {
        x: (clientX - rect.left) * scaleX,
        y: (clientY - rect.top) * scaleY
      };
    }

    // 드래그 이벤트 (마우스 및 터치)
    function startSelection(e) {
      if (!cvReady) return;
      const coords = getCanvasCoords(e);
      startX = coords.x;
      startY = coords.y;
      isDragging = true;
    }

    function moveSelection(e) {
      if (!isDragging) return;
      const coords = getCanvasCoords(e);
      currentX = coords.x;
      currentY = coords.y;
    }

    function endSelection() {
      if (!isDragging) return;
      isDragging = false;

      const x = Math.min(startX, currentX);
      const y = Math.min(startY, currentY);
      const w = Math.abs(currentX - startX);
      const h = Math.abs(currentY - startY);

      if (w > 20 && h > 20) {
        initTracker(x, y, w, h);
      }
    }

    container.addEventListener('mousedown', startSelection);
    container.addEventListener('mousemove', moveSelection);
    window.addEventListener('mouseup', endSelection);

    container.addEventListener('touchstart', startSelection, { passive: true });
    container.addEventListener('touchmove', moveSelection, { passive: true });
    window.addEventListener('touchend', endSelection);

    // 3. OpenCV Tracker (CSRT 기반 추적)
    function initTracker(x, y, w, h) {
      if (tracker) {
        tracker.delete();
      }
      // TrackerKCF 또는 TrackerCSRT 활용
      tracker = new cv.TrackerCSRT();
      
      let src = cv.imread(video);
      let rect = new cv.Rect(x, y, w, h);
      
      tracker.init(src, rect);
      bbox = [x, y, w, h];
      isTracking = true;

      src.delete();
      infoText.innerText = '실시간 추적 중...';
    }

    resetBtn.addEventListener('click', () => {
      isTracking = false;
      if (tracker) {
        tracker.delete();
        tracker = null;
      }
      infoText.innerText = '추적이 해제되었습니다. 대상을 다시 드래그하세요.';
    });

    // 4. 프레임 처리 및 중계 카메라 줌인 효과
    function processVideo() {
      if (video.paused || video.ended) {
        requestAnimationFrame(processVideo);
        return;
      }

      let src = cv.imread(video);

      if (isTracking && tracker) {
        let rect = new cv.Rect();
        let ok = tracker.update(src, rect);

        if (ok) {
          bbox = [rect.x, rect.y, rect.width, rect.height];
        } else {
          infoText.innerText = '대상을 놓쳤습니다. 다시 선택해주세요.';
        }
      }

      // 캔버스 그리기
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      let targetCenterX = canvas.width / 2;
      let targetCenterY = canvas.height / 2;
      let targetZoom = 1;

      if (isTracking && bbox) {
        const [x, y, w, h] = bbox;
        targetCenterX = x + w / 2;
        targetCenterY = y + h / 2;

        // 화면 크기 대비 대상의 상대 비율 계산 후 자동 줌 배율 결정 (최대 4배)
        const sizeRatio = Math.max(w / canvas.width, h / canvas.height);
        targetZoom = Math.min(Math.max(0.35 / sizeRatio, 1.0), 4.0);
      }

      // 방송 중계처럼 부드럽게 카메라인/아웃 (Lerp)
      currentZoom += (targetZoom - currentZoom) * 0.1;
      currentCenterX += (targetCenterX - currentCenterX) * 0.1;
      currentCenterY += (targetCenterY - currentCenterY) * 0.1;

      ctx.save();

      // 줌인 스케일 및 중앙 이동
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.scale(currentZoom, currentZoom);
      ctx.translate(-currentCenterX, -currentCenterY);

      // 비디오 프레임 그리기
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

      // 추적 영역 박스 표시
      if (isTracking && bbox) {
        const [x, y, w, h] = bbox;
        ctx.strokeStyle = '#00ff00';
        ctx.lineWidth = 3 / currentZoom;
        ctx.strokeRect(x, y, w, h);
      }

      ctx.restore();

      // 사용자가 드래그 중인 가이드 박스 표시
      if (isDragging) {
        ctx.strokeStyle = '#ff0000';
        ctx.lineWidth = 2;
        ctx.setLineDash([6, 6]);
        ctx.strokeRect(
          Math.min(startX, currentX),
          Math.min(startY, currentY),
          Math.abs(currentX - startX),
          Math.abs(currentY - startY)
        );
        ctx.setLineDash([]);
      }

      src.delete();
      requestAnimationFrame(processVideo);
    }
  </script>
</body>
</html>
